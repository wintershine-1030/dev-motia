{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/docs",
      "dest": "/docs.html"
    },
    {
      "src": "/manifesto",
      "dest": "/manifesto.html"
    },
    {
      "src": "/rive/(.*)",
      "dest": "/rive/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "/_next/$1"
    },
    {
      "src": "/docs/getting-started/quick-start",
      "dest": "/docs/getting-started/quick-start.html"
    },
    {
      "src": "/docs/getting-started/build-your-first-app/build-your-first-background-jobs",
      "dest": "/docs/getting-started/build-your-first-app/build-your-first-background-jobs.html"
    },
    {
      "src": "/docs/getting-started/build-your-first-app/creating-your-first-rest-api",
      "dest": "/docs/getting-started/build-your-first-app/creating-your-first-rest-api.html"
    },
    {
      "src": "/docs/concepts/steps/api",
      "dest": "/docs/concepts/steps/api.html"
    },
    {
      "src": "/docs/concepts/steps/event",
      "dest": "/docs/concepts/steps/event.html"
    },
    {
      "src": "/docs/concepts/steps/defining-steps",
      "dest": "/docs/concepts/steps/defining-steps.html"
    },
    {
      "src": "/docs/concepts/steps/cron",
      "dest": "/docs/concepts/steps/cron.html"
    },
    {
      "src": "/docs/concepts/flows-and-visualization",
      "dest": "/docs/concepts/flows-and-visualization.html"
    },
    {
      "src": "/docs/concepts/state-management",
      "dest": "/docs/concepts/state-management.html"
    },
    {
      "src": "/docs/concepts/environment-variables",
      "dest": "/docs/concepts/environment-variables.html"
    },
    {
      "src": "/docs/concepts/streams",
      "dest": "/docs/concepts/streams.html"
    },
    {
      "src": "/docs/concepts/logging-and-debugging",
      "dest": "/docs/concepts/logging-and-debugging.html"
    },
    {
      "src": "/docs/concepts/testing",
      "dest": "/docs/concepts/testing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
    
  ]
}
